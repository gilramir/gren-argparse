module Main exposing (main)

{-| Demonstrates `Argparse.Program.runRootWithContext`: the rootless counterpart to
`runWithContext`. There is **no sub-command word** — the tool is invoked as
`wc <file>` — *and* the handler needs a `FileSystem.Permission`, acquired up
front in the initialization phase and threaded through as the program's
*context*.

Like the `with-permissions` example, it exercises all three failure paths:

  - a **missing** file fails the task with `Argparse.Program.ExitMessage`, so its
    error message goes to stderr and the program exits `1`;
  - an **empty** file is a failed check — the handler prints its own note and
    then fails with `Argparse.Program.ExitFailure` (exit `1`, no extra output);
  - a **non-empty** file returns `{}` (exit `0`).

    ./run.sh geng.toml        # prints the size, exits 0
    ./run.sh /no/such/file    # stderr error, exits 1
    ./run.sh /dev/null        # "empty file", exits 1
    ./run.sh --help
    ./run.sh --version
-}

import Argparse.Parser
import Argparse.PrettyPrinter as PP
import Argparse.Program
import Bytes
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Node
import Stream.Log
import Task exposing (Task)


type Command
    = Count { path : Path }


type alias Context =
    { fs : FileSystem.Permission }


command : Argparse.Parser.Command Path {} Command
command =
    { word = ""
    , arguments =
        Argparse.Parser.oneArg
            { value = Argparse.Parser.pathParser
            , help = "The file to measure"
            }
    , flags = Argparse.Parser.noFlags
    , commonDescription = Nothing
    , summary = "Reports a file's size in bytes:"
    , example = PP.words "wc geng.toml"
    , builder =
        \path _flags ->
            Count { path = path }
    }


main : Task Never {}
main =
    Node.getEnvironment
        |> Task.andThen
            (\environment ->
                Argparse.Program.runRootWithContext environment
                    { name = "wc"
                    , version = "1.0.0"
                    , command = command
                    , init =
                        \_env ->
                            FileSystem.initialize
                                |> Task.map (\fsPermission -> { fs = fsPermission })
                    , onCommand =
                        \env context cmd ->
                            when cmd is
                                Count { path } ->
                                    FileSystem.readFile context.fs path
                                        -- A read error (e.g. no such file): print to stderr, exit 1.
                                        |> Task.mapError (\e -> Argparse.Program.ExitMessage (FileSystem.errorToString e))
                                        |> Task.andThen
                                            (\contents ->
                                                if Bytes.length contents == 0 then
                                                    -- Ran fine, but the answer is "no": a
                                                    -- failed check. Print our own note and
                                                    -- exit 1 with no extra diagnostic.
                                                    Stream.Log.line env.stderr
                                                        (Path.toPosixString path ++ " is empty")
                                                        |> Task.andThen (\_ -> Task.fail Argparse.Program.ExitFailure)

                                                else
                                                    Stream.Log.line env.stdout
                                                        (Path.toPosixString path
                                                            ++ ": "
                                                            ++ String.fromInt (Bytes.length contents)
                                                            ++ " bytes"
                                                        )
                                            )
                    }
            )
