module Argparse.PrettyPrinter exposing
    ( Document
    --
    , empty
    , text
    , words
    , indent
    , block
    , verticalBlock
    --
    , Color(..)
    , color
    , intenseColor
    , stripColor
    --
    , ToStringOptions
    , defaultOptions
    , toString
    , toStringWithOptions
    )

{-| This module lets you define how text should be formatted before printing
it to the terminal.


## Wrapping

[toString](#toString) does not wrap: `defaultOptions.maxColumns` is
the largest `Int`, so a `Document` comes out however long it is and the
terminal makes of it what it will. Give it a column budget with
[toStringWithOptions](#toStringWithOptions) and the text is broken to fit.
`Argparse.Program` does this for you — it passes the width of the terminal it
is talking to, falling back to 80 columns when there is no terminal to ask —
so a program built on it wraps its help and error output without doing
anything.

The dots below mark the unused columns of the budget.

[words](#words) breaks between words:

    PP.words "a description long enough to wrap"
        |> PP.toStringWithOptions
            { PP.defaultOptions | maxColumns = 20 }

    a description long··
    enough to wrap······

[text](#text) has no word boundaries to break at, so it breaks wherever the
budget runs out:

    a description long e
    nough to wrap·······

The lines a document wraps onto are rows of their own, so they open under the
same [indent](#indent) as the line they came from:

    PP.words "a description long enough to wrap"
        |> PP.indent
        |> PP.toStringWithOptions
            { PP.defaultOptions | maxColumns = 20 }

        a description···
        long enough to··
        wrap············

Inside a [block](#block), each part is laid out against the columns its
neighbours to the left have already taken — a part does not start at column 0
just because it is a document of its own:

    PP.block
        [ PP.text "--flag "
        , PP.words "a description long enough to wrap"
        ]
        |> PP.indent
        |> PP.toStringWithOptions
            { PP.defaultOptions | maxColumns = 30 }

        --flag a description long·
        enough to wrap············

Only the first line of a part is squeezed that way. Once it wraps it is
starting rows of its own, which get the whole width.

@docs Document
@docs empty, text, words, indent, block, verticalBlock
@docs Color, color, intenseColor, stripColor
@docs toString, ToStringOptions, defaultOptions, toStringWithOptions
-}

import Math


{-| A `Document` represents formatted text.
-}
@derive(Eq, Inspect)
type Document
    = Empty
    | Text String
    | Words (Array String)
    | Colorized { color : Color, intense : Bool, document : Document }
    | Indented Document
    | Block (Array Document)
    | VerticalBlock (Array Document)


{-| The empty [Document](#Document) takes up no space. It's analogous to the
empty `String`.
-}
empty : Document
empty =
    Empty


{-| Turn a `String` into a [Document](#Document). Newlines are not respected,
if you want to spread text over multiple lines, use [verticalBlock](#verticalBlock).

Word boundaries are also not respected. If that's important to you, you might want
to use [words](#words). Under a column budget that means a long `text` is cut
wherever the budget runs out, mid-word if that is where it lands:

    PP.text "a description long enough to wrap"
        |> PP.toStringWithOptions
            { PP.defaultOptions | maxColumns = 20 }

    a description long e
    nough to wrap
-}
text : String -> Document
text str =
    str
        |> String.replace "\r" ""
        |> String.replace "\n" " "
        |> Text


{-| Similar to [text](#text), but word boundaries are respected if the `String` has
to be broken up over multiple lines. Whitespace between words are reduced to a single
space.

    PP.words "a description long enough to wrap"
        |> PP.toStringWithOptions
            { PP.defaultOptions | maxColumns = 20 }

    a description long
    enough to wrap

A word wider than the whole budget still gets a line of its own — it is placed
rather than cut.
-}
words : String -> Document
words str =
    Words <| String.words str


{-| The contents of the [Document](#Document) is indented one level.

The indent is not just a prefix on the first line: the lines the contents wrap
onto are rows of their own, and open under the same indent.

    PP.words "a description long enough to wrap"
        |> PP.indent
        |> PP.toStringWithOptions
            { PP.defaultOptions | maxColumns = 20 }

        a description
        long enough to
        wrap

The indent counts against the budget, so the text above has 16 columns to work
with, not 20.
-}
indent : Document -> Document
indent doc =
    Indented doc


{-| This joins multiple [Documents](#Document) into one. If possible, everything
will be placed on a single line.

Under a column budget, each part is laid out against the columns the parts to
its left have already taken, so it breaks where the row actually runs out
rather than where it would have if it had started the line:

    PP.block
        [ PP.text "--flag "
        , PP.words "a description long enough to wrap"
        ]
        |> PP.indent
        |> PP.toStringWithOptions
            { PP.defaultOptions | maxColumns = 30 }

        --flag a description long
        enough to wrap

Only a part's first line is squeezed that way — it is the one continuing
somebody else's row. The lines it wraps onto are its own, and get the full
width and the surrounding indent.
-}
block : Array Document -> Document
block docs =
    Block docs


{-| Like [block](#block), but each [Document](#Document) is placed on a seperate line.
-}
verticalBlock : Array Document -> Document
verticalBlock docs =
    VerticalBlock docs

-- COLORS


{-| Supported text colors
-}
type Color
    = Black
    | Red
    | Green
    | Yellow
    | Blue
    | Magenta
    | Cyan
    | White


{-| Colorize the text in the given [Document](#Document).
-}
color : Color -> Document -> Document
color clr doc =
    Colorized
        { color = clr
        , intense = False
        , document = doc
        }


{-| Like [color](#color), but intensifies the given color.
-}
intenseColor : Color -> Document -> Document
intenseColor clr doc =
    Colorized
        { color = clr
        , intense = True
        , document = doc
        }


{-| This removes all colorized text in a [Document](#Document).
-}
stripColor : Document -> Document
stripColor doc =
    when doc is
        Empty ->
            doc

        Text _ ->
            doc

        Words _ ->
            doc

        Colorized { document = colorizedDocument } ->
            colorizedDocument

        Indented document ->
            Indented <| stripColor document

        Block docs ->
            Block <| Array.map stripColor docs

        VerticalBlock docs ->
            VerticalBlock <| Array.map stripColor docs


ansiColorCode : Color -> Bool -> String
ansiColorCode clr intense =
    let
        baseValue =
            when clr is
                Black ->
                    30

                Red ->
                    31

                Green ->
                    32

                Yellow ->
                    33

                Blue ->
                    34

                Magenta ->
                    35

                Cyan ->
                    36

                White ->
                    37

        appliedIntensity =
            if intense then
                baseValue + 60

            else
                baseValue
    in
    String.fromInt appliedIntensity


ansiColorEscapePrefix : String
ansiColorEscapePrefix =
    "\u{001b}["

-- RUN


{-| Convert a [Document](#Document) into a `String` that's ready to be written
to the terminal.
-}
toString : Document -> String
toString doc =
    toStringWithOptions defaultOptions doc


{-| Different settings when converting a [Document](#Document) into `String`.

* `maxColumns` defines the maximum number of characters in a line. No rendered
  line is wider than this, indent included; see [words](#words) for how the
  text is broken to fit, and the module header for worked examples.
* `indentationSize` defines the number of spaces per indentation level.
* `newlineSeparator` defines the `String` used for representing newlines.
-}
type alias ToStringOptions =
    { maxColumns : Int
    , indentationSize : Int
    , newlineSeparator : String
    }


{-| A default set of options for converting [Document](#Document) into `String`.

`maxColumns` is the largest `Int` here, which is to say these options do
not wrap at all. Pass a real width to
[toStringWithOptions](#toStringWithOptions) to get wrapping — or let
`Argparse.Program` do it, which renders with the width of the terminal it is
talking to and 80 columns when there is no terminal.
-}
defaultOptions : ToStringOptions
defaultOptions =
    { -- unlimited: the largest `Int`, where stock used 2^53 - 1, which is a `Float` on Geng
      maxColumns = 2147483647
    , indentationSize = 4
    , newlineSeparator = "\n"
    }


{-| Like [toString](#toString), but allows you to override the default options.
-}
toStringWithOptions : ToStringOptions -> Document -> String
toStringWithOptions { maxColumns, indentationSize, newlineSeparator } doc =
    toStringHelper
        { indentPrefix = ""
        , continuationPrefix = ""
        , nextIndent =
            \currentIndent -> String.repeat indentationSize " " ++ currentIndent
        , maxColumns = maxColumns
        , newlineSeparator = newlineSeparator
        , startColumn = 0
        }
        doc


{-| Everything the renderer needs in order to lay out one Document.

`startColumn` is how much of the current row is already spoken for by the
documents rendered before this one: 0 in a vertical context, and the width of
the parts to its left inside a [block](#block). It squeezes only the *first*
line of a document — once a document wraps, the lines after the break begin
rows of their own and get the full width.

The two prefixes are that same first-line/rest split. `indentPrefix` opens a
document's first line and `continuationPrefix` opens the lines after a break.
They differ only for a [block](#block) part that is not the first: its first
line continues a row that already carries the indent, so re-emitting the
prefix there would push four spaces into the middle of the row — but the lines
it wraps onto are rows of their own, and belong under the indent like anything
else.
-}
type alias Layout =
    { indentPrefix : String
    , continuationPrefix : String
    , nextIndent : String -> String
    , maxColumns : Int
    , newlineSeparator : String
    , startColumn : Int
    }


toStringHelper : Layout -> Document -> String
toStringHelper layout doc =
    when doc is
        Empty ->
            ""

        Text str ->
            let
                indentedText =
                    layout.indentPrefix ++ str
            in
            if
                String.count indentedText
                    + layout.startColumn
                    > layout.maxColumns
            then
                indentedText
                    |> splitByLength
                        { first = max 1 (layout.maxColumns - layout.startColumn)
                        , rest =
                            max 1
                                (layout.maxColumns
                                    - String.count layout.continuationPrefix
                                )
                        }
                    |> prefixWrappedLines "" layout.continuationPrefix
                    |> String.join layout.newlineSeparator

            else
                indentedText

        Words parts ->
            let
                wordSplitter =
                    Array.foldl
                        (addToWordSplitter
                            { first =
                                layout.maxColumns
                                    - layout.startColumn
                                    - String.count layout.indentPrefix
                            , rest =
                                layout.maxColumns
                                    - String.count layout.continuationPrefix
                            }
                        )
                        emptyWordSplitter
                        parts
            in
            Array.pushLast wordSplitter.currentLine wordSplitter.lines
                |> Array.map (String.join " ")
                |> prefixWrappedLines layout.indentPrefix
                    layout.continuationPrefix
                |> String.join layout.newlineSeparator

        Colorized { color = clr, intense, document } ->
            String.join "" <|
                [ ansiColorEscapePrefix ++ ansiColorCode clr intense ++ "m"
                , toStringHelper layout document
                , ansiColorEscapePrefix ++ "39m"
                ]

        Indented document ->
            toStringHelper
                { layout
                    | indentPrefix = layout.nextIndent layout.indentPrefix
                    , continuationPrefix =
                        layout.nextIndent layout.continuationPrefix
                }
                document

        Block docs ->
            when Array.popFirst docs is
                Nothing ->
                    ""

                Just { first, rest } ->
                    let
                        firstPart =
                            toStringHelper layout first
                    in
                    Array.foldl (addBlockPart layout)
                        { rendered = firstPart
                        , column =
                            columnAfter layout.newlineSeparator
                                layout.startColumn firstPart
                        }
                        rest
                        |> .rendered

        VerticalBlock docs ->
            when Array.popFirst docs is
                Nothing ->
                    ""

                Just { first, rest } ->
                    Array.pushFirst
                        (toStringHelper layout first)
                        (Array.map
                            (toStringHelper
                                { layout
                                    | startColumn = 0
                                    , indentPrefix = layout.continuationPrefix
                                }
                            )
                            rest
                        )
                        |> String.join layout.newlineSeparator


{-| Render one of the parts that follow the first in a horizontal
[block](#block), and report where the row stands afterwards. The part is told
how many columns its neighbours to the left have already taken, because it does
*not* start at column 0 — without that it would wrap against the full width and
break in the wrong place.
-}
addBlockPart :
    Layout
    -> Document
    -> { rendered : String, column : Int }
    -> { rendered : String, column : Int }
addBlockPart layout doc { rendered, column } =
    let
        part =
            toStringHelper
                { layout
                    | indentPrefix = ""
                    , nextIndent = identity
                    , startColumn = column
                }
                doc
    in
    { rendered = rendered ++ part
    , column = columnAfter layout.newlineSeparator column part
    }


{-| Open each line with the prefix its position calls for: the first line
continues wherever it was placed, and every line after a break starts a row of
its own, under the indent.
-}
prefixWrappedLines : String -> String -> Array String -> Array String
prefixWrappedLines firstPrefix continuationPrefix lines =
    when Array.popFirst lines is
        Nothing ->
            []

        Just { first, rest } ->
            Array.pushFirst
                (firstPrefix ++ first)
                (Array.map (\line -> continuationPrefix ++ line) rest)


{-| The column the row stands at after `rendered` has been written, given that
it started at `startColumn`. Text that wrapped has left us on a fresh row, so
only its last line counts.
-}
columnAfter : String -> Int -> String -> Int
columnAfter newlineSeparator startColumn rendered =
    let
        lines =
            String.split newlineSeparator rendered
    in
    when Array.last lines is
        Nothing ->
            startColumn

        Just lastLine ->
            if Array.length lines <= 1 then
                startColumn + visibleWidth lastLine

            else
                visibleWidth lastLine


{-| The width of a rendered line as the terminal sees it. The ANSI escape
sequences that [color](#color) wraps text in take up no columns of their own.
-}
visibleWidth : String -> Int
visibleWidth line =
    String.foldl
        (\char acc ->
            if acc.inEscape then
                { acc | inEscape = char /= 'm' }

            else if char == ansiEscape then
                { acc | inEscape = True }

            else
                { acc | width = acc.width + 1 }
        )
        { inEscape = False, width = 0 }
        line
        |> .width


ansiEscape : Char
ansiEscape =
    '\u{001b}'


{-| Hard-split a string into chunks: the first line gets `first` characters,
because part of its row may already be taken, and every line after it gets
`rest`.
-}
splitByLength : { first : Int, rest : Int } -> String -> Array String
splitByLength { first, rest } str =
    splitByLengthHelper rest
        (String.dropFirst first str)
        [ String.takeFirst first str ]


splitByLengthHelper : Int -> String -> Array String -> Array String
splitByLengthHelper size str acc =
    if str == "" then
        acc

    else
        let
            first =
                String.takeFirst size str

            rest =
                String.dropFirst size str
        in
        splitByLengthHelper size rest (Array.pushLast first acc)


type alias WordSplitter =
    { currentLine : Array String
    , lines : Array (Array String)
    }


emptyWordSplitter : WordSplitter
emptyWordSplitter =
    { currentLine = []
    , lines = []
    }


addToWordSplitter :
    { first : Int, rest : Int }
    -> String
    -> WordSplitter
    -> WordSplitter
addToWordSplitter widths str { currentLine, lines } =
    if currentLine == [] then
        { currentLine = [ str ]
        , lines = lines
        }

    else
        let
            maxWidth =
                if lines == [] then
                    widths.first

                else
                    widths.rest

            currentWidth =
                String.join " " currentLine
                    |> String.count
        in
        if String.count str + 1 + currentWidth > maxWidth then
            addToWordSplitter widths str
                { currentLine = []
                , lines = Array.pushLast currentLine lines
                }

        else
            { currentLine = Array.pushLast str currentLine
            , lines = lines
            }
